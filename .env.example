# Copier ce fichier vers .env avant de démarrer Docker Compose.
# Ne jamais mettre de vrai secret dans ce fichier public.

# Identifiants de la base PostgreSQL utilisée par Synapse
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=change-me-locally

# Port PostgreSQL exposé sur la machine locale
POSTGRES_PORT=5432

# Identifiant de l'utilisateur et du groupe Linux utilisés par Synapse
# Adapter ces valeurs à la machine locale avec :
# id -u
# id -g
UID=1000
GID=1000
